{
  "name": "@cormijs/plugin-export-static",
  "description": "Pre-render the pages of Cormi apps into HTML files for static hosts",
  "version": "0.1.0-rc.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src"
  ],
  "license": "MIT",
  "homepage": "https://github.com/cormijs/cormi/tree/main/plugins/plugin-export-static#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cormijs/cormi.git",
    "directory": "plugins/plugin-export-static"
  },
  "bugs": {
    "url": "https://github.com/cormijs/cormi/issues"
  },
  "keywords": [
    "cormi",
    "cormi-plugin",
    "cordis",
    "ssg",
    "export-static",
    "bundler:*",
    "renderer:*"
  ],
  "cormi": {},
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "cormi": "workspace:*"
  },
  "devDependencies": {
    "@cormijs/preset": "workspace:*",
    "@cormijs/react": "workspace:*",
    "@cormijs/rsbuild": "workspace:*",
    "@cormijs/vite": "workspace:*",
    "@cormijs/vue": "workspace:*",
    "cormi": "workspace:*"
  }
}
