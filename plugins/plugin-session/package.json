{
  "name": "@cormijs/plugin-session",
  "description": "Cookie sessions for Cormi apps: state.session, stored in ctx.cache",
  "version": "0.1.0-rc.3",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src"
  ],
  "license": "MIT",
  "homepage": "https://github.com/cormijs/cormi/tree/main/plugins/plugin-session#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cormijs/cormi.git",
    "directory": "plugins/plugin-session"
  },
  "bugs": {
    "url": "https://github.com/cormijs/cormi/issues"
  },
  "keywords": [
    "cormi",
    "cormi-plugin",
    "cordis",
    "session",
    "cookie",
    "bundler:*",
    "renderer:*",
    "required:cache",
    "required:middleware",
    "impl:session"
  ],
  "cormi": {
    "service": {
      "required": [
        "cache",
        "middleware"
      ],
      "implements": [
        "session"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@cormijs/cache": "workspace:*",
    "@cormijs/cormi": "workspace:*"
  },
  "devDependencies": {
    "@cormijs/cache": "workspace:*",
    "@cormijs/cormi": "workspace:*",
    "@cormijs/preset": "workspace:*",
    "@cormijs/react": "workspace:*",
    "@cormijs/rsbuild": "workspace:*",
    "@cormijs/vite": "workspace:*",
    "@cormijs/vue": "workspace:*"
  }
}
