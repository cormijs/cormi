{
  "name": "@cormijs/plugin-lint",
  "description": "cormi lint: ESLint with a default config for TypeScript and React hooks",
  "version": "0.1.0-rc.3",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src"
  ],
  "license": "MIT",
  "homepage": "https://github.com/cormijs/cormi/tree/main/plugins/plugin-lint#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cormijs/cormi.git",
    "directory": "plugins/plugin-lint"
  },
  "bugs": {
    "url": "https://github.com/cormijs/cormi/issues"
  },
  "keywords": [
    "cormi",
    "cormi-plugin",
    "cordis",
    "eslint",
    "lint",
    "bundler:*",
    "renderer:*"
  ],
  "cormi": {},
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@cormijs/cormi": "workspace:*"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.72.1"
  },
  "devDependencies": {
    "@cormijs/preset": "workspace:*",
    "@cormijs/react": "workspace:*",
    "@cormijs/rsbuild": "workspace:*",
    "@cormijs/vite": "workspace:*",
    "@cormijs/vue": "workspace:*",
    "@cormijs/cormi": "workspace:*"
  }
}
