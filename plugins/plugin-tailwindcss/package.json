{
  "name": "@cormi/plugin-tailwindcss",
  "description": "Tailwind CSS v4 for Cormi apps",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src"
  ],
  "license": "MIT",
  "keywords": [
    "cormi",
    "cormi-plugin",
    "cordis",
    "tailwindcss"
  ],
  "cormi": {
    "bundler": [
      "vite",
      "rsbuild"
    ]
  },
  "peerDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "cormi": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@tailwindcss/postcss": {
      "optional": true
    },
    "@tailwindcss/vite": {
      "optional": true
    }
  },
  "dependencies": {
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@cormi/rsbuild": "workspace:*",
    "@cormi/vite": "workspace:*",
    "@rsbuild/core": "^2.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "cormi": "workspace:*",
    "vite": "^7.3.7"
  }
}
