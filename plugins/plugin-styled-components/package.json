{
  "name": "@cormijs/plugin-styled-components",
  "description": "styled-components for Cormi apps: theme and server-rendered styles",
  "version": "0.1.0-rc.3",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/index.tsx",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "client"
  ],
  "license": "MIT",
  "homepage": "https://github.com/cormijs/cormi/tree/main/plugins/plugin-styled-components#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cormijs/cormi.git",
    "directory": "plugins/plugin-styled-components"
  },
  "bugs": {
    "url": "https://github.com/cormijs/cormi/issues"
  },
  "keywords": [
    "cormi",
    "cormi-plugin",
    "cordis",
    "styled-components",
    "css-in-js",
    "bundler:vite",
    "renderer:react"
  ],
  "cormi": {
    "bundler": [
      "vite"
    ],
    "renderer": [
      "react"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@cormijs/react": "workspace:*",
    "@cormijs/cormi": "workspace:*",
    "react": ">=19",
    "styled-components": "^6"
  },
  "devDependencies": {
    "@cormijs/preset": "workspace:*",
    "@cormijs/react": "workspace:*",
    "@cormijs/rsbuild": "workspace:*",
    "@cormijs/vite": "workspace:*",
    "@cormijs/vue": "workspace:*",
    "@types/react": "^19.3.0",
    "@cormijs/cormi": "workspace:*",
    "react": "^19.3.1",
    "styled-components": "^6.6.0"
  }
}
