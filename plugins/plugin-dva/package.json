{
  "name": "@cormi/plugin-dva",
  "description": "dva for Cormi apps: redux and redux-saga with models of src/models",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/index.tsx",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "client"
  ],
  "license": "MIT",
  "keywords": [
    "cormi",
    "cormi-plugin",
    "cordis",
    "dva",
    "redux"
  ],
  "peerDependencies": {
    "@cormi/react": "workspace:*",
    "cormi": "workspace:*",
    "react": ">=19"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "cordis": "4.0.0-rc.12",
    "dva-core": "^2.0.4",
    "dva-loading": "^3.0.25",
    "immer": "^10.1.3",
    "react-redux": "^9.3.1",
    "redux": "^4.2.1",
    "regenerator-runtime": "^0.14.1"
  },
  "devDependencies": {
    "@cormi/react": "workspace:*",
    "@types/react": "^19.3.0",
    "cormi": "workspace:*",
    "react": "^19.3.1"
  }
