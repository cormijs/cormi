{
  "name": "@cormijs/plugin-dva",
  "description": "dva for Cormi apps: redux and redux-saga with models of src/models",
  "version": "0.1.0-rc.1",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/index.tsx",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "client"
  ],
  "license": "MIT",
  "homepage": "https://github.com/cormijs/cormi/tree/main/plugins/plugin-dva#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cormijs/cormi.git",
    "directory": "plugins/plugin-dva"
  },
  "bugs": {
    "url": "https://github.com/cormijs/cormi/issues"
  },
  "keywords": [
    "cormi",
    "cormi-plugin",
    "cordis",
    "dva",
    "redux",
    "bundler:*",
    "renderer:react"
  ],
  "cormi": {
    "renderer": [
      "react"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@cormijs/react": "workspace:*",
    "@cormijs/cormi": "workspace:*",
    "react": ">=19"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "cordis": "4.0.0-rc.12",
    "dva-core": "^2.0.4",
    "dva-loading": "^3.0.25",
    "immer": "^10.1.3",
    "react-redux": "^9.3.1",
    "redux": "^4.2.1",
    "regenerator-runtime": "^0.14.1"
  },
  "devDependencies": {
    "@cormijs/preset": "workspace:*",
    "@cormijs/react": "workspace:*",
    "@cormijs/rsbuild": "workspace:*",
    "@cormijs/vite": "workspace:*",
    "@cormijs/vue": "workspace:*",
    "@types/react": "^19.3.0",
    "@cormijs/cormi": "workspace:*",
    "react": "^19.3.1"
  }
}
