{
  "name": "@cormijs/plugin-qiankun",
  "description": "qiankun micro frontends for Cormi apps: the master (MicroApp) and Vite-built micro apps",
  "version": "0.1.0-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./master": {
      "source": "./src/master.ts",
      "types": "./lib/master.d.ts",
      "default": "./lib/master.js"
    },
    "./master/client": "./client/master.tsx",
    "./slave": {
      "source": "./src/slave.ts",
      "types": "./lib/slave.d.ts",
      "default": "./lib/slave.js"
    },
    "./slave/client": "./client/slave.tsx",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "client"
  ],
  "license": "MIT",
  "homepage": "https://github.com/cormijs/cormi/tree/main/plugins/plugin-qiankun#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cormijs/cormi.git",
    "directory": "plugins/plugin-qiankun"
  },
  "bugs": {
    "url": "https://github.com/cormijs/cormi/issues"
  },
  "keywords": [
    "cormi",
    "cormi-plugin",
    "cordis",
    "qiankun",
    "micro-frontends",
    "bundler:*",
    "renderer:react"
  ],
  "cormi": {
    "renderer": [
      "react"
    ],
    "exports": {
      "./slave": {
        "bundler": [
          "vite"
        ]
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@cormijs/react": "workspace:*",
    "@cormijs/vite": "workspace:*",
    "@cormijs/cormi": "workspace:*",
    "react": ">=19"
  },
  "dependencies": {
    "qiankun": "^2.10.16"
  },
  "devDependencies": {
    "@cormijs/preset": "workspace:*",
    "@cormijs/react": "workspace:*",
    "@cormijs/rsbuild": "workspace:*",
    "@cormijs/vite": "workspace:*",
    "@cormijs/vue": "workspace:*",
    "@types/react": "^19.3.0",
    "@cormijs/cormi": "workspace:*",
    "react": "^19.3.1"
  }
}
