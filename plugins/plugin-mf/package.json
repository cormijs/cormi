{
  "name": "@cormi/plugin-mf",
  "description": "Module federation for Cormi apps, with @module-federation/vite",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src"
  ],
  "license": "MIT",
  "keywords": [
    "cormi",
    "cormi-plugin",
    "cordis",
    "module-federation",
    "micro-frontends"
  ],
  "peerDependencies": {
    "@module-federation/rsbuild-plugin": "^2.9.2",
    "@module-federation/vite": "^1.23.7",
    "cormi": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@module-federation/rsbuild-plugin": {
      "optional": true
    },
    "@module-federation/vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cormi/rsbuild": "workspace:*",
    "@cormi/vite": "workspace:*",
    "@module-federation/rsbuild-plugin": "^2.9.2",
    "@module-federation/vite": "^1.23.7",
    "@rsbuild/core": "^2.3.0",
    "cormi": "workspace:*",
    "vite": "^7.3.7"
  }
}
