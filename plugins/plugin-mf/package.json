{
  "name": "@cormijs/plugin-mf",
  "description": "Module federation for Cormi apps, with @module-federation/vite",
  "version": "0.1.0-rc.3",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src"
  ],
  "license": "MIT",
  "homepage": "https://github.com/cormijs/cormi/tree/main/plugins/plugin-mf#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cormijs/cormi.git",
    "directory": "plugins/plugin-mf"
  },
  "bugs": {
    "url": "https://github.com/cormijs/cormi/issues"
  },
  "keywords": [
    "cormi",
    "cormi-plugin",
    "cordis",
    "module-federation",
    "micro-frontends",
    "bundler:vite",
    "bundler:rsbuild",
    "renderer:*"
  ],
  "cormi": {
    "bundler": [
      "vite",
      "rsbuild"
    ],
    "check": {
      ".": {
        "name": "check"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@module-federation/rsbuild-plugin": "^2.9.2",
    "@module-federation/vite": "^1.23.7",
    "@cormijs/cormi": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@module-federation/rsbuild-plugin": {
      "optional": true
    },
    "@module-federation/vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cormijs/preset": "workspace:*",
    "@cormijs/react": "workspace:*",
    "@cormijs/rsbuild": "workspace:*",
    "@cormijs/vite": "workspace:*",
    "@cormijs/vue": "workspace:*",
    "@module-federation/rsbuild-plugin": "^2.9.2",
    "@module-federation/vite": "^1.23.7",
    "@rsbuild/core": "^2.3.0",
    "@cormijs/cormi": "workspace:*",
    "vite": "^7.3.7"
  }
}
