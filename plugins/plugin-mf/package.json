{
  "name": "@cormi/plugin-mf",
  "description": "Module federation for Cormi apps, with @module-federation/vite",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
