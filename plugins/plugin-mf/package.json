    "./package.json": "./package.json"
  },
  "files": ["lib", "src"],
  "license": "MIT",
  "keywords": ["cormi", "cormi-plugin", "cordis", "module-federation", "micro-frontends"],
  "peerDependencies": {
    "cormi": "workspace:*"
  },
  "dependencies": {
    "@module-federation/vite": "^1.23.7",
    "vite": "^7.3.7"
  },
  "devDependencies": {
    "cormi": "workspace:*"
  }
