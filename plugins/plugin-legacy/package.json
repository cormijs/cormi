{
  "name": "@cormi/plugin-legacy",
  "description": "Legacy browsers for Cormi apps, with @vitejs/plugin-legacy",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src"
  ],
  "license": "MIT",
  "keywords": [
    "cormi",
    "cormi-plugin",
    "cordis",
    "legacy",
    "polyfill"
  ],
  "peerDependencies": {
    "@cormi/vite": "workspace:*",
    "cormi": "workspace:*"
  },
  "dependencies": {
    "@vitejs/plugin-legacy": "^7.2.1",
    "terser": "^5.44.0",
    "vite": "^7.3.7"
  },
  "devDependencies": {
    "@cormi/vite": "workspace:*",
    "cormi": "workspace:*"
  }
}
