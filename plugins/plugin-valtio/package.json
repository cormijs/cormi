{
  "name": "@cormijs/plugin-valtio",
  "description": "valtio for Cormi apps, with stores connected to Redux DevTools",
  "version": "0.1.0-rc.3",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "client"
  ],
  "license": "MIT",
  "homepage": "https://github.com/cormijs/cormi/tree/main/plugins/plugin-valtio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cormijs/cormi.git",
    "directory": "plugins/plugin-valtio"
  },
  "bugs": {
    "url": "https://github.com/cormijs/cormi/issues"
  },
  "keywords": [
    "cormi",
    "cormi-plugin",
    "cordis",
    "valtio",
    "state",
    "bundler:*",
    "renderer:react"
  ],
  "cormi": {
    "renderer": [
      "react"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@cormijs/react": "workspace:*",
    "@cormijs/cormi": "workspace:*",
    "react": ">=19"
  },
  "dependencies": {
    "valtio": "^2.3.2"
  },
  "devDependencies": {
    "@cormijs/preset": "workspace:*",
    "@cormijs/react": "workspace:*",
    "@cormijs/rsbuild": "workspace:*",
    "@cormijs/vite": "workspace:*",
    "@cormijs/vue": "workspace:*",
    "@types/react": "^19.3.0",
    "@cormijs/cormi": "workspace:*",
    "react": "^19.3.1"
  }
}
