{
  "name": "@cormi/plugin-valtio",
  "description": "valtio for Cormi apps, with stores connected to Redux DevTools",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "client"
  ],
  "license": "MIT",
  "keywords": [
    "cormi",
    "cormi-plugin",
    "cordis",
    "valtio",
    "state",
    "bundler:*",
    "renderer:react"
  ],
  "cormi": {
    "renderer": [
      "react"
    ]
  },
  "peerDependencies": {
    "@cormi/react": "workspace:*",
    "cormi": "workspace:*",
    "react": ">=19"
  },
  "dependencies": {
    "valtio": "^2.3.2"
  },
  "devDependencies": {
    "@cormi/preset": "workspace:*",
    "@cormi/react": "workspace:*",
    "@cormi/rsbuild": "workspace:*",
    "@cormi/vite": "workspace:*",
    "@cormi/vue": "workspace:*",
    "@types/react": "^19.3.0",
    "cormi": "workspace:*",
    "react": "^19.3.1"
  }
}
