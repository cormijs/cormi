{
  "name": "@cormi/root",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.6.3",
  "scripts": {
    "build": "tsc -b",
    "build:clean": "tsc -b --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "typecheck:client": "node scripts/typecheck-client.mjs",
    "check:plugins": "node scripts/check-plugins.mjs",
    "e2e": "node --import tsx scripts/e2e.mts",
    "e2e:dev": "node --import tsx scripts/e2e.mts --dev",
    "docs:dev": "pnpm --filter @cormi/docs dev",
    "docs:build": "pnpm --filter @cormi/docs build",
    "docs:preview": "pnpm --filter @cormi/docs preview"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12",
    "vite": "^7.3.7"
  },
  "pnpm": {
    "overrides": {
      "vite": "^7.3.7",
      "vitepress>vite": "^5.4.14"
    }
  }
}
