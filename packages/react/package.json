{
  "name": "@cormi/react",
  "description": "React for Cormi apps: the renderer of the route table, and the browser API (@cormi/react/client) with react-router and server rendering",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/node/index.js",
  "types": "lib/node/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/node/index.ts",
      "types": "./lib/node/index.d.ts",
      "default": "./lib/node/index.js"
    },
    "./client": {
      "source": "./src/client/index.ts",
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client/index.js"
    },
    "./client/server": {
      "source": "./src/client/server.tsx",
      "types": "./lib/client/server.d.ts",
      "default": "./lib/client/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@babel/generator": "^7.29.8",
    "@babel/parser": "^7.29.11",
    "@babel/traverse": "^7.29.10",
    "@babel/types": "^7.29.0",
    "@cormi/core": "workspace:*",
    "@cormi/runtime": "workspace:*",
    "@vitejs/plugin-react": "^5.2.0",
    "babel-dead-code-elimination": "^2.0.0",
    "cordis": "4.0.0-rc.12",
    "cosmokit": "^1.8.1",
    "react-router": "^7.18.5",
    "vite": "^7.3.7"
  },
  "devDependencies": {
    "@cormi/vite": "workspace:*",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "keywords": [
    "cormi",
    "cordis",
    "react",
    "renderer"
  ]
}
