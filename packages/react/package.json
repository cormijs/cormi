{
  "name": "@cormi/react",
  "description": "React for Cormi apps: the renderer of the route table, and the browser API (@cormi/react/client) with react-router and server rendering",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/node/index.js",
  "types": "lib/node/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/node/index.ts",
      "types": "./lib/node/index.d.ts",
      "default": "./lib/node/index.js"
    },
    "./client": {
      "source": "./src/client/index.ts",
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client/index.js"
    },
    "./client/server": {
      "source": "./src/client/server.tsx",
      "types": "./lib/client/server.d.ts",
      "default": "./lib/client/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@rsbuild/plugin-react": "^2.1.1",
    "@vitejs/plugin-react": "^5.2.0",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "@rsbuild/plugin-react": {
      "optional": true
    },
    "@vitejs/plugin-react": {
      "optional": true
    }
  },
  "dependencies": {
    "@cormi/core": "workspace:*",
    "@cormi/runtime": "workspace:*",
    "cordis": "4.0.0-rc.12",
    "cosmokit": "^1.8.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@cormi/rsbuild": "workspace:*",
    "@cormi/vite": "workspace:*",
    "@rsbuild/core": "^2.3.0",
    "@rsbuild/plugin-react": "^2.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^7.3.7"
  },
  "keywords": [
    "cormi",
    "cordis",
    "react",
    "renderer"
  ],
  "cormi": {
    "renderer": [
      "react"
    ],
    "service": {
      "implements": [
        "renderer",
        "react"
      ]
    }
  }
}
