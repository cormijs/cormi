{
  "name": "@cormijs/cache",
  "description": "The cache of a Cormi app (ctx.cache): key-value tables with expiry, in memory; Redis and the database with @cormijs/cache-redis and @cormijs/cache-database",
  "version": "0.1.0-rc.3",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src"
  ],
  "license": "MIT",
  "homepage": "https://github.com/cormijs/cormi/tree/main/packages/cache#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cormijs/cormi.git",
    "directory": "packages/cache"
  },
  "bugs": {
    "url": "https://github.com/cormijs/cormi/issues"
  },
  "keywords": [
    "cormi",
    "cormi-plugin",
    "cordis",
    "cache",
    "bundler:*",
    "renderer:*",
    "impl:cache"
  ],
  "cormi": {
    "service": {
      "implements": [
        "cache"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@cormijs/core": "workspace:*",
    "cordis": "4.0.0-rc.12"
  },
  "devDependencies": {
    "@cormijs/cormi": "workspace:*",
    "@cormijs/preset": "workspace:*",
    "@cormijs/react": "workspace:*",
    "@cormijs/rsbuild": "workspace:*",
    "@cormijs/vite": "workspace:*",
    "@cormijs/vue": "workspace:*"
  }
}
