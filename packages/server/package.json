{
  "name": "@cormi/server",
  "description": "Request handling of Cormi on ctx.server: pages (SSR), server loaders, API routes and static files",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
