{
  "name": "@cormi/client",
  "description": "The browser side of Cormi: a cordis context with the app root and the router, and server rendering",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./server": {
      "source": "./src/server.tsx",
      "types": "./lib/server.d.ts",
      "default": "./lib/server.js"
    },
    "./constants": {
      "source": "./src/constants.ts",
      "types": "./lib/constants.d.ts",
      "default": "./lib/constants.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "cordis": "4.0.0-rc.12",
    "cosmokit": "^1.8.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "keywords": [
    "cormi",
    "cordis",
    "react",
    "client"
  ]
}
