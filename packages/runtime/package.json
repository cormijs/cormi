{
  "name": "@cormijs/runtime",
  "description": "The browser runtime of Cormi without a UI framework: the cordis context, the app's lifecycle, the route table and the loader protocol",
  "version": "0.1.0-rc.3",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./constants": {
      "source": "./src/constants.ts",
      "types": "./lib/constants.d.ts",
      "default": "./lib/constants.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src"
  ],
  "license": "MIT",
  "homepage": "https://github.com/cormijs/cormi/tree/main/packages/runtime#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cormijs/cormi.git",
    "directory": "packages/runtime"
  },
  "bugs": {
    "url": "https://github.com/cormijs/cormi/issues"
  },
  "keywords": [
    "cormi",
    "cordis",
    "runtime"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "cordis": "4.0.0-rc.12",
    "cosmokit": "^1.8.1"
  }
}
