{
  "name": "@cormijs/ai",
  "description": "The AI service of a Cormi app (ctx.ai): chat, streaming responses, tool calling and exposing server/api as MCP tools; replaceable providers with @cormijs/ai-openai and @cormijs/ai-anthropic",
  "version": "0.1.0-rc.3",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src"
  ],
  "license": "MIT",
  "homepage": "https://github.com/cormijs/cormi/tree/main/packages/ai#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cormijs/cormi.git",
    "directory": "packages/ai"
  },
  "bugs": {
    "url": "https://github.com/cormijs/cormi/issues"
  },
  "keywords": [
    "cormi",
    "cormi-plugin",
    "cordis",
    "ai",
    "llm",
    "mcp",
    "openai",
    "anthropic",
    "bundler:*",
    "renderer:*",
    "impl:ai"
  ],
  "cormi": {
    "service": {
      "implements": [
        "ai"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@cordisjs/plugin-server": "^1.7.0",
    "@cormijs/core": "workspace:*",
    "@cormijs/server": "workspace:*",
    "cordis": "4.0.0-rc.12"
  },
  "devDependencies": {
    "@cormijs/cormi": "workspace:*",
    "@cormijs/preset": "workspace:*",
    "@cormijs/react": "workspace:*",
    "@cormijs/rsbuild": "workspace:*",
    "@cormijs/vite": "workspace:*",
    "@cormijs/vue": "workspace:*"
  }
}
