{
  "name": "@cormijs/preset",
  "description": "A Cormi app without its bundler and UI framework: the router, html, pages, API routes, the HTTP server and the console",
  "version": "0.1.0-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src"
  ],
  "license": "MIT",
  "homepage": "https://github.com/cormijs/cormi/tree/main/packages/preset#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cormijs/cormi.git",
    "directory": "packages/preset"
  },
  "bugs": {
    "url": "https://github.com/cormijs/cormi/issues"
  },
  "keywords": [
    "cormi",
    "cordis",
    "preset",
    "cormi-plugin",
    "bundler:*",
    "renderer:*",
    "impl:router",
    "impl:html",
    "impl:app",
    "impl:server"
  ],
  "cormi": {
    "service": {
      "implements": [
        "router",
        "html",
        "app",
        "server"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@cordisjs/plugin-server": "^1.7.0",
    "@cormijs/console": "workspace:*",
    "@cormijs/core": "workspace:*",
    "@cormijs/server": "workspace:*",
    "chokidar": "^4.0.3",
    "cordis": "4.0.0-rc.12",
    "cosmokit": "^1.8.1",
    "postcss": "^8.5.6"
  },
  "devDependencies": {
    "@cormijs/rsbuild": "workspace:*",
    "@cormijs/vite": "workspace:*"
  }
}
