{
  "name": "@cormi/preset",
  "description": "A Cormi app without its bundler and UI framework: the router, html, pages, API routes, the HTTP server and the console",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src"
  ],
  "license": "MIT",
  "keywords": [
    "cormi",
    "cordis",
    "preset"
  ],
  "dependencies": {
    "@cordisjs/plugin-server": "^1.7.0",
    "@cormi/console": "workspace:*",
    "@cormi/core": "workspace:*",
    "@cormi/server": "workspace:*",
    "chokidar": "^4.0.3",
    "cordis": "4.0.0-rc.12",
    "cosmokit": "^1.8.1",
    "postcss": "^8.5.6"
  },
  "devDependencies": {
    "@cormi/rsbuild": "workspace:*",
    "@cormi/vite": "workspace:*"
  }
}
