{
  "name": "@cormijs/vite",
  "description": "The Vite service of Cormi: dev server on ctx.server, client and server bundles",
  "version": "0.1.0-rc.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src"
  ],
  "license": "MIT",
  "homepage": "https://github.com/cormijs/cormi/tree/main/packages/vite#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cormijs/cormi.git",
    "directory": "packages/vite"
  },
  "bugs": {
    "url": "https://github.com/cormijs/cormi/issues"
  },
  "keywords": [
    "cormi",
    "cordis",
    "vite",
    "plugin",
    "cormi-plugin",
    "bundler:vite",
    "renderer:*",
    "impl:bundler",
    "impl:vite"
  ],
  "cormi": {
    "bundler": [
      "vite"
    ],
    "service": {
      "implements": [
        "bundler",
        "vite"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@cordisjs/plugin-loader": "1.0.0-rc.9",
    "@cordisjs/plugin-server": "^1.7.0",
    "@cormijs/core": "workspace:*",
    "cordis": "4.0.0-rc.12",
    "cosmokit": "^1.8.1",
    "vite": "^7.3.7"
  }
}
