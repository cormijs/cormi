{
  "name": "@cormijs/create",
  "description": "Create a Cormi app: a frontend, a backend, both, or pages rendered on the server",
  "version": "0.1.0-rc.2",
  "type": "module",
  "bin": {
    "create-cormi": "bin/create.js"
  },
  "main": "lib/index.js",
