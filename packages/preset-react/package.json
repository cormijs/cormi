{
  "name": "@cormi/preset-react",
  "description": "A React app bundled by Vite: @cormi/preset, @cormi/vite and @cormi/react with one flat config",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src"
  ],
  "license": "MIT",
  "keywords": [
    "cormi",
    "cordis",
    "preset",
    "react"
  ],
  "dependencies": {
    "@cormi/core": "workspace:*",
    "@cormi/preset": "workspace:*",
    "@cormi/react": "workspace:*",
    "@cormi/vite": "workspace:*",
    "@vitejs/plugin-react": "^5.2.0",
    "cordis": "4.0.0-rc.12"
  },
  "peerDependencies": {
    "cormi": "workspace:*",
    "react": ">=19",
    "react-dom": ">=19"
  }
}
