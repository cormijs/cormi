{
  "name": "@cormi/console",
  "description": "The console of a Cormi app in dev mode: the plugin tree, the app's internals, logs, the workspace and the market",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/index.tsx",
    "./client/builtin": "./client/builtin/index.tsx",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "client"
  ],
  "license": "MIT",
  "keywords": [
    "cormi",
    "cordis",
    "console",
    "devtools"
  ],
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@cordisjs/plugin-loader": "1.0.0-rc.9",
    "@cordisjs/plugin-server": "^1.7.0",
    "@cormi/core": "workspace:*",
    "@cormi/react": "workspace:*",
    "@cormi/vite": "workspace:*",
    "@fontsource-variable/recursive": "^5.3.0",
    "cordis": "4.0.0-rc.12",
    "cosmokit": "^1.8.1",
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
