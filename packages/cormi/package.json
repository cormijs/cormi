{
  "name": "cormi",
  "description": "A React full-stack framework built on Cordis: the CLI, the node API for plugins and the browser API (cormi/client)",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "cormi": "bin/cormi.js"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "source": "./src/client.ts",
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./client/server": {
      "source": "./src/client-server.ts",
      "types": "./lib/client-server.d.ts",
      "default": "./lib/client-server.js"
    },
    "./console": "./console.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "src",
    "console.ts"
  ],
  "license": "MIT",
  "keywords": [
    "cormi",
    "cordis",
    "react",
    "framework",
    "ssr"
  ],
  "cordis": {
    "ecosystem": {
      "name": "cormi",
      "pattern": [
        "@cormi/plugin-*",
        "cormi-plugin-*"
      ]
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@cordisjs/plugin-loader": "1.0.0-rc.9",
    "@cordisjs/plugin-server": "^1.7.0",
    "@cormi/client": "workspace:*",
    "@cormi/console": "workspace:*",
    "@cormi/core": "workspace:*",
    "@cormi/server": "workspace:*",
    "@cormi/vite": "workspace:*",
    "cordis": "4.0.0-rc.12",
    "react-router": "^7.18.5",
    "tsx": "^4.23.15",
    "yargs-parser": "^21.1.1"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@types/yargs-parser": "^21.0.3"
  }
}
