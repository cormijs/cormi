{
  "name": "@cormijs/cormi",
  "description": "A React full-stack framework built on Cordis: the CLI, the node API for plugins and the browser API (cormi/client)",
  "version": "0.1.0-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "cormi": "bin/cormi.js"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "source": "./src/client.ts",
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./console": "./console.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "src",
    "console.ts"
  ],
  "license": "MIT",
  "homepage": "https://github.com/cormijs/cormi/tree/main/packages/cormi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cormijs/cormi.git",
    "directory": "packages/cormi"
  },
  "bugs": {
    "url": "https://github.com/cormijs/cormi/issues"
  },
  "keywords": [
    "cormi",
    "cordis",
    "react",
    "framework",
    "ssr"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@cordisjs/plugin-loader": "1.0.0-rc.9",
    "@cordisjs/plugin-server": "^1.7.0",
    "@cormijs/console": "workspace:*",
    "@cormijs/core": "workspace:*",
    "@cormijs/runtime": "workspace:*",
    "@cormijs/server": "workspace:*",
    "cordis": "4.0.0-rc.12",
    "import-meta-resolve": "^4.2.0",
    "tsx": "^4.23.15",
    "yargs-parser": "^21.1.1"
  },
  "devDependencies": {
    "@types/yargs-parser": "^21.0.3"
  },
  "cordis": {
    "ecosystem": {
      "name": "cormi",
      "pattern": [
        "@cormijs/plugin-*",
        "cormi-plugin-*"
      ]
    }
  }
}
